{
  "name": "bjs-gas",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "BJ's gas price collector on Prisma Compute; native cron scheduler",
  "scripts": {
    "build": "pnpm run build:api && pnpm run build:web",
    "build:api": "node scripts/build-api.mjs",
    "build:web": "pnpm --filter web run build",
    "audit:gas-aliases": "node scripts/audit-gas-aliases.mjs",
    "discover": "tsx src/cli.ts discover",
    "discover:clubs": "tsx src/cli.ts discover:clubs",
    "discover:gas": "tsx src/cli.ts discover:gas",
    "discovery:diff": "tsx src/cli.ts discovery:diff",
    "discovery:accept": "tsx src/cli.ts discovery:accept",
    "discover:sitemap-canary": "tsx src/cli.ts discover:sitemap-canary",
    "import:clubs": "tsx src/cli.ts import:clubs",
    "collect:club": "tsx src/cli.ts collect:club",
    "collect:once": "tsx src/cli.ts collect:once",
    "typecheck": "tsc --noEmit && pnpm run typecheck:deploy && pnpm run typecheck:web",
    "typecheck:deploy": "tsc -p tsconfig.deploy.json --noEmit",
    "typecheck:web": "pnpm --filter web run typecheck",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "pretest": "node web/scripts/copy-maplibre-worker.js",
    "test": "vitest run",
    "test:integration": "vitest run tests/persist.integration.test.ts tests/analytics-scope.integration.test.ts",
    "skills:sync": "pnpm dlx --allow-build=esbuild @prisma/cli@8.0.0-rc.34 skills sync --config prisma.skills.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "deploy:compute": "node scripts/check-clean-tree.mjs && pnpm run build && pnpm dlx --allow-build=esbuild @prisma/cli@8.0.0-rc.34 deploy --config prisma.composer.config.ts --name bjs-gas",
    "composer:check": "tsx scripts/check-composer.ts"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@bjs-gas/contracts": "workspace:*",
    "@honeybadger-io/js": "^6.17.4",
    "@prisma/client": "^6.19.3",
    "@prisma/composer": "0.39.0",
    "@prisma/composer-prisma-cloud": "0.39.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "alchemy": "2.0.0-beta.85",
    "arktype": "^2.2.10",
    "effect": "4.1.0",
    "hono": "^4.13.20",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  }
}
