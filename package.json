{
  "name": "bjs-gas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BJ's gas price collector on Prisma Compute; native cron scheduler",
  "scripts": {
    "build": "pnpm run build:api && pnpm run build:web",
    "build:api": "node scripts/build-api.mjs",
    "build:web": "pnpm --filter web run build",
    "audit:gas-aliases": "node scripts/audit-gas-aliases.mjs",
    "discover": "tsx src/cli.ts discover",
    "discover:clubs": "tsx src/cli.ts discover:clubs",
    "discover:gas": "tsx src/cli.ts discover:gas",
    "discovery:diff": "tsx src/cli.ts discovery:diff",
    "discovery:accept": "tsx src/cli.ts discovery:accept",
    "discover:sitemap-canary": "tsx src/cli.ts discover:sitemap-canary",
    "probe:sitemap": "node scripts/probe-sitemap-discovery.mjs",
    "import:clubs": "tsx src/cli.ts import:clubs",
    "collect:club": "tsx src/cli.ts collect:club",
    "collect:once": "tsx src/cli.ts collect:once",
    "typecheck": "pnpm run typecheck:core && pnpm run typecheck:deploy && pnpm run typecheck:web",
    "typecheck:core": "tsc -p tsconfig.json --noEmit",
    "typecheck:deploy": "tsc -p tsconfig.deploy.json --noEmit",
    "typecheck:web": "pnpm --filter web run typecheck",
    "pretest": "node web/scripts/copy-maplibre-worker.js",
    "test": "vitest run",
    "test:integration": "vitest run tests/persist.integration.test.ts",
    "lint": "pnpm run typecheck:core",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "deploy:compute": "node scripts/check-clean-tree.mjs && pnpm run build && pnpm dlx @prisma/cli@latest deploy module.ts --name bjs-gas"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@honeybadger-io/js": "^6.16.3",
    "@prisma/client": "^6.19.3",
    "@prisma/composer": "^0.18.0",
    "@prisma/composer-prisma-cloud": "^0.18.0",
    "alchemy": "2.0.0-beta.74",
    "arktype": "^2.2.3",
    "effect": "4.0.0-rc.112",
    "hono": "^4.13.7",
    "playwright": "^1.55.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@prisma/config>effect": "3.21.0",
    "effect": "4.0.0-rc.112"
  }
}
